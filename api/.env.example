# api/ — FastAPI settings (app/core/config.py). Copy to api/.env.local for local dev (gitignored).
# Production values live in the Vercel project `platter-api`.

# Neon Postgres with PostGIS. The pooled URL (host contains "-pooler") is fine: the app turns
# asyncpg's statement cache off for it. `postgresql://…?sslmode=require` is accepted as-is.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5434/platter_dev
# Migrations and the seed never read DATABASE_URL — name the target per command:
#   ALEMBIC_URL=… uv run alembic upgrade head
#   SEED_DATABASE_URL=… uv run python -m app.seed.seed
# Tests: a throwaway PostGIS database (wiped by every run).
# TEST_DATABASE_URL=postgresql+asyncpg://postgres@localhost:5434/platter_test

# The web origin (cookies are Secure when this is https) and the secret its /api/revalidate
# route expects (must equal web REVALIDATE_SECRET). Generate: openssl rand -hex 32
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=

# Razorpay, test mode. Leave the key unset and online payment is off (checkout offers COD only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only where the webhook is registered (production): https://platter.virajdomadia.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Open services, no account. "off" disables the call (straight-line legs / "drop the pin").
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io

# Sim customers place an order now and then while someone watches the board or the admin map.
AMBIENT_ORDERS=true

# Shared with the web (same value): it proves the visitor IP the web forwards for rate limits.
PROXY_SECRET=
